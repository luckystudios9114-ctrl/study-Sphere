  <!-- ============================================================
       STUDYSPHERE DATA + NAVIGATION + 3D VIZ ENGINE
       Everything below is modular on purpose:
       - Add a chapter  -> add one object to STUDY_DATA[class][subject].chapters
       - Add notes      -> fill a chapter's `notes` array with blocks
       - Add a 3D model -> write one init function and register it in VIZ_REGISTRY
       ============================================================ -->
  <script src="https://cdn.jsdelivr.net/npm/three@0.160.0/build/three.min.js"></script>
  <script>
    /* =========================================================
       1. DATA — edit/extend this to add real content
       ========================================================= */
    const SUBJECT_META = {
      botany:   { label: 'Botany',   icon: '🌿' },
      zoology:  { label: 'Zoology',  icon: '🐾' },
      genetics: { label: 'Genetics', icon: '🧬' }
    };

    function ch(title, opts) {
      opts = opts || {};
      return { title, notes: opts.notes || null, viz: opts.viz || null };
    }

    const STUDY_DATA = {
      11: {
        botany: {
          chapters: [
            ch('The Living World'),
            ch('Biological Classification'),
            ch('Plant Kingdom'),
            ch('Morphology of Flowering Plants'),
            ch('Anatomy of Flowering Plants'),
            ch('Cell: The Unit of Life', {
              viz: 'cell',
              notes: [
                { type: 'card', title: '🌱 What is a Cell?', body:
                  'The cell is the fundamental structural and functional unit of every living organism. Some organisms are single-celled, while others are complex, multicellular systems built from trillions of cooperating cells.' },
                { type: 'important', title: '🎯 Important', body:
                  'Every cell arises from a pre-existing cell — this is the Cell Theory, one of the unifying principles of biology.' },
                { type: 'heading', text: '1. Prokaryotic vs Eukaryotic Cells' },
                { type: 'card', title: '🧫 Prokaryotic Cells', body:
                  'Lack a true, membrane-bound nucleus. DNA lies free in the cytoplasm in a region called the nucleoid. Bacteria are the classic example.' },
                { type: 'card', title: '🧬 Eukaryotic Cells', body:
                  'Have a well-defined nucleus enclosed by a nuclear envelope, along with membrane-bound organelles such as mitochondria, the endoplasmic reticulum and the Golgi apparatus.' },
                { type: 'heading', text: '2. Key Organelles' },
                { type: 'card', title: '⚡ Mitochondria', body:
                  'Known as the "powerhouse of the cell" — the site of aerobic respiration and ATP generation.' },
                { type: 'card', title: '🏭 Golgi Apparatus', body:
                  'Modifies, packages and dispatches proteins and lipids received from the endoplasmic reticulum.' },
                { type: 'hierarchy', text: 'Nucleus → Nucleolus → Chromatin → DNA' }
              ]
            }),
            ch('Cell Cycle and Cell Division'),
            ch('Photosynthesis in Higher Plants'),
            ch('Respiration in Plants'),
            ch('Plant Growth and Development')
          ]
        },
        zoology: {
          chapters: [
            ch('Animal Kingdom'),
            ch('Structural Organisation in Animals'),
            ch('Biomolecules'),
            ch('Digestion and Absorption'),
            ch('Breathing and Exchange of Gases'),
            ch('Body Fluids and Circulation'),
            ch('Excretory Products and their Elimination'),
            ch('Locomotion and Movement'),
            ch('Neural Control and Coordination'),
            ch('Chemical Coordination and Integration')
          ]
        },
        genetics: {
          chapters: [
            ch('Introduction to Heredity'),
            ch('Chromosomes and DNA'),
            ch('Cell Division and Genetic Continuity'),
            ch('Mendel and the Basics of Inheritance')
          ]
        }
      },
      12: {
        botany: {
          chapters: [
            ch('Sexual Reproduction in Flowering Plants'),
            ch('Microbes in Human Welfare'),
            ch('Organisms and Populations'),
            ch('Ecosystem'),
            ch('Biodiversity and Conservation')
          ]
        },
        zoology: {
          chapters: [
            ch('Human Reproduction'),
            ch('Reproductive Health'),
            ch('Human Health and Disease'),
            ch('Strategies for Enhancement in Food Production')
          ]
        },
        genetics: {
          chapters: [
            ch('Principles of Inheritance and Variation'),
            ch('Molecular Basis of Inheritance', {
              viz: 'dna',
              notes: [
                { type: 'card', title: '🧬 The Structure of DNA', body:
                  'DNA is a double helix made of two antiparallel polynucleotide strands, held together by hydrogen bonds between complementary nitrogenous bases.' },
                { type: 'important', title: '🎯 Important', body:
                  'Adenine pairs with Thymine (2 hydrogen bonds); Guanine pairs with Cytosine (3 hydrogen bonds).' },
                { type: 'heading', text: '1. Replication' },
                { type: 'card', title: '🔁 Semi-conservative Replication', body:
                  'Each strand of the parent DNA acts as a template for a new complementary strand, so every daughter molecule retains one old and one new strand.' },
                { type: 'heading', text: '2. From Gene to Protein' },
                { type: 'hierarchy', text: 'DNA → mRNA (Transcription) → Protein (Translation)' }
              ]
            }),
            ch('Evolution'),
            ch('Biotechnology: Principles and Processes')
          ]
        }
      }
    };

    /* =========================================================
       2. NAVIGATION STATE + WINDOW HELPERS
       ========================================================= */
    const nav = { classId: null, subjectKey: null, chapterIndex: null };

    function show(id) { document.getElementById(id).classList.add('active'); }
    function hide(id) { document.getElementById(id).classList.remove('active'); }

    function crumb(el, parts) {
      el.innerHTML = parts.map((p, i) => {
        const isLast = i === parts.length - 1;
        return `<span class="${isLast ? 'crumb-current' : ''}">${p}</span>` +
               (isLast ? '' : '<span class="crumb-sep">›</span>');
      }).join('');
    }

    // ---- Class window ----
    function openClass(classId) {
      nav.classId = classId;
      document.getElementById('classTitle').textContent = 'Class ' + classId + ' Biology';
      crumb(document.getElementById('classCrumb'), ['Studysphere', 'Class ' + classId]);

      const grid = document.getElementById('classSubjectGrid');
      grid.innerHTML = '';
      Object.keys(SUBJECT_META).forEach(key => {
        const meta = SUBJECT_META[key];
        const count = (STUDY_DATA[classId][key] || { chapters: [] }).chapters.length;
        const card = document.createElement('div');
        card.className = 'subject-card';
        card.innerHTML =
          `<div class="subject-icon">${meta.icon}</div>
           <h3>${meta.label}</h3>
           <p>${count} chapters available to explore.</p>
           <button>Explore →</button>`;
        card.querySelector('button').onclick = () => openSubject(classId, key);
        grid.appendChild(card);
      });

      show('classWindow');
    }
    function closeClass() { hide('classWindow'); }

    // ---- Subject window (chapter list) ----
    function openSubject(classId, subjectKey) {
      nav.classId = classId;
      nav.subjectKey = subjectKey;
      const meta = SUBJECT_META[subjectKey];
      const data = STUDY_DATA[classId][subjectKey];

      document.getElementById('subjectIcon').textContent = meta.icon;
      document.getElementById('subjectTitle').textContent = meta.label;
      document.getElementById('subjectDescription').textContent =
        `Class ${classId} • ${data.chapters.length} chapters`;
      crumb(document.getElementById('subjectCrumb'),
        ['Studysphere', 'Class ' + classId, meta.label]);

      const list = document.getElementById('chapterList');
      list.innerHTML = '';
      data.chapters.forEach((chapter, index) => {
        const item = document.createElement('div');
        item.className = 'chapter-item';
        item.innerHTML =
          `<div class="chapter-item-icon">${chapter.viz ? '🧪' : '📖'}</div>
           <div class="chapter-item-info">
             <h4>${index + 1}. ${chapter.title}</h4>
             <p>${chapter.notes ? 'Notes ready' : 'Coming soon'}${chapter.viz ? ' • 3D model' : ''}</p>
           </div>
           <span class="chapter-item-arrow">→</span>`;
        item.onclick = () => openChapter(classId, subjectKey, index);
        list.appendChild(item);
      });

      hide('classWindow');
      show('subjectWindow');
    }
    function closeSubject() { hide('subjectWindow'); }
    function backToClass() { hide('subjectWindow'); show('classWindow'); }

    // ---- Chapter window (action grid) ----
    function openChapter(classId, subjectKey, chapterIndex) {
      nav.classId = classId;
      nav.subjectKey = subjectKey;
      nav.chapterIndex = chapterIndex;

      const meta = SUBJECT_META[subjectKey];
      const chapter = STUDY_DATA[classId][subjectKey].chapters[chapterIndex];

      document.getElementById('chapterIcon').textContent = chapter.viz ? '🧪' : '📖';
      document.getElementById('chapterTitle').textContent = chapter.title;
      document.getElementById('chapterSubject').textContent = `${meta.label} • Class ${classId}`;
      crumb(document.getElementById('chapterCrumb'),
        ['Studysphere', 'Class ' + classId, meta.label, chapter.title]);

      document.getElementById('chapterNotice').style.display = chapter.notes ? 'none' : 'block';

      hide('subjectWindow');
      show('chapterWindow');
    }
    function closeChapter() { hide('chapterWindow'); }
    function backToSubject() {
      hide('chapterWindow');
      openSubject(nav.classId, nav.subjectKey);
    }
    function chapterComingSoon(feature) {
      alert(feature + ' for this chapter is coming soon! 🚀');
    }

    /* =========================================================
       3. NOTES RENDERER
       ========================================================= */
    function renderNotesBlocks(blocks) {
      return blocks.map(b => {
        if (b.type === 'heading') return `<h3>${b.text}</h3>`;
        if (b.type === 'hierarchy') return `<div class="hierarchy-box">${b.text}</div>`;
        if (b.type === 'important') {
          return `<div class="important-box"><strong>${b.title}</strong><p>${b.body}</p></div>`;
        }
        return `<div class="notes-card"><strong>${b.title}</strong><p>${b.body}</p></div>`;
      }).join('');
    }

    function openNotes() {
      const { classId, subjectKey, chapterIndex } = nav;
      const meta = SUBJECT_META[subjectKey];
      const chapter = STUDY_DATA[classId][subjectKey].chapters[chapterIndex];

      document.getElementById('notesTitle').textContent = chapter.title;
      document.getElementById('notesSubtitle').textContent =
        `${meta.label} • Class ${classId} • NCERT`;
      crumb(document.getElementById('notesCrumb'),
        ['Studysphere', 'Class ' + classId, meta.label, chapter.title, 'Notes']);

      const content = document.getElementById('notesContent');
      content.innerHTML = chapter.notes
        ? renderNotesBlocks(chapter.notes)
        : `<div class="chapter-notice">🚀 Notes for this chapter are coming soon — the page is already wired up, just add content to <code>STUDY_DATA</code>.</div>`;

      const vizWrap = document.getElementById('notesVizWrap');
      teardownActiveViz();
      if (chapter.viz && VIZ_REGISTRY[chapter.viz]) {
        vizWrap.style.display = 'block';
        document.getElementById('notesVizLabel').textContent =
          chapter.viz === 'dna' ? '🧬 INTERACTIVE 3D MODEL — DNA DOUBLE HELIX'
                                 : '🧪 INTERACTIVE 3D MODEL — CELL STRUCTURE';
        const mount = document.getElementById('notesVizCanvas');
        mount.innerHTML = '';
        activeVizCleanup = VIZ_REGISTRY[chapter.viz](mount);
      } else {
        vizWrap.style.display = 'none';
      }

      hide('chapterWindow');
      show('notesWindow');
    }
    function closeNotes() { teardownActiveViz(); hide('notesWindow'); }
    function backToChapter() {
      teardownActiveViz();
      hide('notesWindow');
      openChapter(nav.classId, nav.subjectKey, nav.chapterIndex);
    }

    /* =========================================================
       4. 3D VISUALIZATION ENGINE
       Add a new model by writing an init(container) function that
       returns a cleanup() function, then register it below.
       ========================================================= */
    let activeVizCleanup = null;
    function teardownActiveViz() {
      if (activeVizCleanup) { activeVizCleanup(); activeVizCleanup = null; }
    }

    function createBaseScene(container) {
      const scene = new THREE.Scene();
      const camera = new THREE.PerspectiveCamera(45, 1, 0.1, 100);
      const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
      container.appendChild(renderer.domElement);

      scene.add(new THREE.AmbientLight(0xffffff, 0.6));
      const key = new THREE.DirectionalLight(0x66aaff, 1.1);
      key.position.set(5, 6, 8);
      scene.add(key);
      const rim = new THREE.DirectionalLight(0x22e08a, 0.7);
      rim.position.set(-6, -4, -6);
      scene.add(rim);

      function resize() {
        const w = container.clientWidth, h = container.clientHeight;
        if (!w || !h) return;
        renderer.setSize(w, h, false);
        camera.aspect = w / h;
        camera.updateProjectionMatrix();
      }
      resize();
      const ro = window.ResizeObserver ? new ResizeObserver(resize) : null;
      if (ro) ro.observe(container);
      window.addEventListener('resize', resize);

      return { scene, camera, renderer, resize, ro };
    }

    function initDNAViz(container) {
      const { scene, camera, renderer, ro } = createBaseScene(container);
      camera.position.set(0, 0, 12);

      const group = new THREE.Group();
      scene.add(group);

      const turns = 3, points = 40, radius = 1.3, height = 8;
      const colorA = new THREE.Color(0x2563eb), colorB = new THREE.Color(0x22c55e);
      const sphereGeo = new THREE.SphereGeometry(0.15, 14, 14);
      const rungGeo = new THREE.CylinderGeometry(0.03, 0.03, 1, 8);
      const matA = new THREE.MeshStandardMaterial({ color: colorA, emissive: colorA, emissiveIntensity: 0.25 });
      const matB = new THREE.MeshStandardMaterial({ color: colorB, emissive: colorB, emissiveIntensity: 0.25 });
      const matRung = new THREE.MeshStandardMaterial({ color: 0x7dd3fc, emissive: 0x7dd3fc, emissiveIntensity: 0.15, transparent: true, opacity: 0.85 });

      for (let i = 0; i < points; i++) {
        const t = i / (points - 1);
        const angle = t * Math.PI * 2 * turns;
        const y = (t - 0.5) * height;
        const x1 = Math.cos(angle) * radius, z1 = Math.sin(angle) * radius;
        const x2 = Math.cos(angle + Math.PI) * radius, z2 = Math.sin(angle + Math.PI) * radius;

        const s1 = new THREE.Mesh(sphereGeo, matA); s1.position.set(x1, y, z1); group.add(s1);
        const s2 = new THREE.Mesh(sphereGeo, matB); s2.position.set(x2, y, z2); group.add(s2);

        if (i % 3 === 0) {
          const len = Math.hypot(x2 - x1, z2 - z1);
          const rung = new THREE.Mesh(rungGeo, matRung);
          rung.scale.y = len;
          rung.position.set((x1 + x2) / 2, y, (z1 + z2) / 2);
          rung.lookAt(new THREE.Vector3(x2, y, z2));
          rung.rotateX(Math.PI / 2);
          group.add(rung);
        }
      }

      let raf, t = 0;
      function animate() {
        raf = requestAnimationFrame(animate);
        t += 0.006;
        group.rotation.y = t;
        renderer.render(scene, camera);
      }
      animate();

      return function cleanup() {
        cancelAnimationFrame(raf);
        if (ro) ro.disconnect();
        renderer.dispose();
        container.innerHTML = '';
      };
    }

    function initCellViz(container) {
      const { scene, camera, renderer, ro } = createBaseScene(container);
      camera.position.set(0, 0, 11);

      const group = new THREE.Group();
      scene.add(group);

      // Cell membrane
      const membrane = new THREE.Mesh(
        new THREE.IcosahedronGeometry(3.2, 1),
        new THREE.MeshStandardMaterial({ color: 0x60a5fa, transparent: true, opacity: 0.18, wireframe: true })
      );
      group.add(membrane);

      // Nucleus
      const nucleus = new THREE.Mesh(
        new THREE.SphereGeometry(1.05, 24, 24),
        new THREE.MeshStandardMaterial({ color: 0x7c3aed, emissive: 0x7c3aed, emissiveIntensity: 0.3 })
      );
      group.add(nucleus);

      // Organelles orbiting the nucleus
      const organelles = [
        { color: 0xf97316, size: 0.32, dist: 2.1, speed: 0.9, label: 'Mitochondria' },
        { color: 0x22c55e, size: 0.26, dist: 2.5, speed: 0.6, label: 'Golgi apparatus' },
        { color: 0xfacc15, size: 0.22, dist: 1.7, speed: 1.3, label: 'Ribosome' },
        { color: 0x38bdf8, size: 0.3, dist: 2.8, speed: 0.4, label: 'ER' }
      ].map(o => {
        const mesh = new THREE.Mesh(
          new THREE.SphereGeometry(o.size, 16, 16),
          new THREE.MeshStandardMaterial({ color: o.color, emissive: o.color, emissiveIntensity: 0.35 })
        );
        group.add(mesh);
        return { mesh, ...o, angle: Math.random() * Math.PI * 2 };
      });

      let raf, t = 0;
      function animate() {
        raf = requestAnimationFrame(animate);
        t += 0.01;
        group.rotation.y = t * 0.4;
        organelles.forEach(o => {
          o.angle += 0.01 * o.speed;
          o.mesh.position.set(Math.cos(o.angle) * o.dist, Math.sin(o.angle * 0.7) * 0.6, Math.sin(o.angle) * o.dist);
        });
        renderer.render(scene, camera);
      }
      animate();

      return function cleanup() {
        cancelAnimationFrame(raf);
        if (ro) ro.disconnect();
        renderer.dispose();
        container.innerHTML = '';
      };
    }

    const VIZ_REGISTRY = { dna: initDNAViz, cell: initCellViz };

    /* =========================================================
       5. HERO DNA HELIX (homepage background visual)
       ========================================================= */
    function initHeroDNA() {
      const mount = document.getElementById('dna3d-canvas');
      if (!mount || typeof THREE === 'undefined') return;
      mount.style.height = mount.parentElement.clientHeight + 'px';
      const cleanup = initDNAViz(mount);
      // hero visual is decorative and never torn down
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initHeroDNA);
    } else {
      initHeroDNA();
    }
  </script>

