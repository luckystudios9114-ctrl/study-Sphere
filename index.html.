<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Studysphere | Biology Learning Universe</title>

  <link rel="stylesheet" href="./style.css">

  <style>
    /* ===== Original chapter-window styling (kept) ===== */
    .chapter-window-content { max-width: 720px; }

    #chapterSubject {
      margin-top: -8px;
      color: #66788c;
      font-size: 14px;
      font-weight: 600;
    }

    .chapter-action-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 14px;
      margin-top: 30px;
    }

    .chapter-action-grid button {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 5px;
      padding: 20px;
      border: 1px solid rgba(37, 99, 235, 0.12);
      border-radius: 16px;
      background: #f8fbff;
      color: #102238;
      text-align: left;
      cursor: pointer;
      transition: 0.25s ease;
    }

    .chapter-action-grid button:hover {
      transform: translateY(-4px);
      background: #eef6ff;
      border-color: rgba(37, 99, 235, 0.25);
      box-shadow: 0 12px 30px rgba(30, 80, 150, 0.08);
    }

    .chapter-action-grid button:first-child { font-size: 25px; }
    .chapter-action-grid button span { font-size: 15px; font-weight: 800; }
    .chapter-action-grid button small { color: #66788c; font-size: 12px; line-height: 1.4; }

    .chapter-notice {
      margin-top: 18px;
      padding: 14px 16px;
      border-radius: 13px;
      background: rgba(36, 119, 255, 0.07);
      color: #315477;
      font-size: 13px;
      line-height: 1.5;
    }

    @media (max-width: 600px) {
      .chapter-action-grid { grid-template-columns: 1fr; }
    }

    /* ===== 3D DNA HERO VISUAL (from earlier) ===== */
    .biology-visual { position: relative; }

    #dna3d-canvas {
      position: absolute;
      inset: 0;
      z-index: 2;
      pointer-events: none;
    }

    #dna3d-canvas canvas { display: block; width: 100%; height: 100%; }

    .floating-item { position: relative; z-index: 3; }

    /* ===== NEW: Class 11 / Class 12 selector on the homepage ===== */
    .class-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 22px;
      max-width: 900px;
      margin: 0 auto;
    }

    .class-card {
      position: relative;
      padding: 30px 26px;
      border-radius: 22px;
      border: 1px solid rgba(37, 99, 235, 0.12);
      background: linear-gradient(155deg, #ffffff 0%, #f4f9ff 100%);
      box-shadow: 0 14px 34px rgba(20, 60, 120, 0.06);
      cursor: pointer;
      transition: 0.28s ease;
      overflow: hidden;
    }

    .class-card:hover {
      transform: translateY(-6px);
      border-color: rgba(37, 99, 235, 0.3);
      box-shadow: 0 20px 46px rgba(20, 60, 120, 0.12);
    }

    .class-badge {
      display: inline-block;
      padding: 5px 12px;
      border-radius: 999px;
      background: rgba(37, 99, 235, 0.1);
      color: #2563eb;
      font-size: 12px;
      font-weight: 800;
      letter-spacing: 0.4px;
      margin-bottom: 14px;
    }

    .class-card h3 { font-size: 21px; margin: 0 0 8px; color: #102238; }
    .class-card p { color: #66788c; font-size: 13.5px; line-height: 1.5; margin: 0 0 16px; }

    .class-subjects-preview {
      display: flex;
      gap: 10px;
      font-size: 22px;
      margin-bottom: 18px;
    }

    .class-card .go-btn {
      border: none;
      background: #2563eb;
      color: #fff;
      padding: 10px 18px;
      border-radius: 12px;
      font-weight: 700;
      font-size: 13px;
      cursor: pointer;
    }

    @media (max-width: 640px) {
      .class-grid { grid-template-columns: 1fr; }
    }

    /* ===== NEW: breadcrumb + back button used across modals ===== */
    .crumb-nav {
      display: flex;
      align-items: center;
      gap: 6px;
      flex-wrap: wrap;
      font-size: 12.5px;
      font-weight: 700;
      color: #7c8ba1;
      margin-bottom: 6px;
    }

    .crumb-nav .crumb-sep { color: #c3ceda; }
    .crumb-nav .crumb-current { color: #2563eb; }

    .back-btn {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      border: none;
      background: rgba(37, 99, 235, 0.08);
      color: #2563eb;
      font-weight: 700;
      font-size: 12.5px;
      padding: 7px 12px;
      border-radius: 10px;
      cursor: pointer;
      margin-bottom: 14px;
    }

    .back-btn:hover { background: rgba(37, 99, 235, 0.16); }

    /* ===== NEW: 3D visualization slot inside chapter notes ===== */
    .notes-viz-wrap {
      margin: 22px 0;
      border-radius: 18px;
      overflow: hidden;
      border: 1px solid rgba(37, 99, 235, 0.12);
      background: radial-gradient(circle at 30% 20%, rgba(37,99,235,0.08), transparent 60%), #0b1120;
    }

    .notes-viz-label {
      padding: 10px 16px;
      font-size: 12px;
      font-weight: 800;
      letter-spacing: 0.4px;
      color: #9fb4d8;
      background: rgba(255,255,255,0.03);
    }

    .notes-viz-canvas { width: 100%; height: 280px; }
    .notes-viz-canvas canvas { width: 100%; height: 100%; display: block; }

    /* ===== NEW: chapter list items (in case style.css doesn't already style these) ===== */
    .chapter-list { display: flex; flex-direction: column; gap: 10px; margin-top: 22px; }

    .chapter-item {
      display: flex;
      align-items: center;
      gap: 14px;
      padding: 14px 16px;
      border-radius: 14px;
      border: 1px solid rgba(37, 99, 235, 0.1);
      background: #f8fbff;
      cursor: pointer;
      transition: 0.2s ease;
    }

    .chapter-item:hover {
      background: #eef6ff;
      border-color: rgba(37, 99, 235, 0.25);
      transform: translateX(4px);
    }

    .chapter-item-icon { font-size: 20px; }
    .chapter-item-info { flex: 1; }
    .chapter-item-info h4 { margin: 0 0 2px; font-size: 14.5px; color: #102238; }
    .chapter-item-info p { margin: 0; font-size: 12px; color: #7c8ba1; }
    .chapter-item-arrow { color: #2563eb; font-weight: 800; }
  </style>

</head>

